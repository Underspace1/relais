# Copie ce fichier en ".env" et remplis tes clés.
# (Tu peux aussi les saisir directement dans l'app : Réglages.)

# Le plus simple : une seule clé OpenRouter pour Claude, ChatGPT, Grok, Gemini et Perplexity (rien à installer)
OPENROUTER_API_KEY=
# Modèles OpenRouter (vide = le plus récent de chaque IA)
OPENROUTER_CLAUDE_MODEL=
OPENROUTER_GPT_MODEL=
OPENROUTER_GROK_MODEL=
OPENROUTER_GEMINI_MODEL=
OPENROUTER_PERPLEXITY_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_GEMINI_IMAGE_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Gemini : clé gratuite sur aistudio.google.com/apikey (les images demandent la facturation)
GEMINI_API_KEY=
# Perplexity : recherche web avec sources (perplexity.ai → Paramètres → API)
PERPLEXITY_API_KEY=

# Modèles (modifiables)
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
GROK_MODEL=grok-4
GROK_IMAGE_MODEL=grok-2-image
# Gemini : vide = le plus récent (Pro pour le texte, Nano Banana pour les images)
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
PERPLEXITY_MODEL=sonar-pro

# Cursor (agent en ligne de commande "cursor-agent")
CURSOR_ENABLED=false
CURSOR_WORKSPACE=
CURSOR_COMMAND=cursor-agent
CURSOR_ALLOW_WRITES=false

PORT=4321

# Voix : "auto" (OpenAI si clé, sinon Windows), "windows" ou "openai"
VOICE_ENGINE=auto
VOICE_LANG=fr-FR
VOICE_OPENAI_MODEL=gpt-4o-mini-transcribe
